# {{ ansible_managed }}
# Handles WALL-E's pending requests as the operator. In notify mode (default) it
# only moves each request to outbox/reviewing/ and logs it; in review mode it
# reviews in a headless Claude Code run. The job must move every request out of
# outbox/pending, or the path unit starts it again; the start limit stops a loop.
[Unit]
Description=Operator review of WALL-E's requests
StartLimitIntervalSec=1h
StartLimitBurst=4

[Service]
Type=oneshot
User={{ walle_reviewer }}
UMask=0027
WorkingDirectory={{ walle_reviewer_home }}/projects/digitaleraluhut
Environment=PATH={{ walle_reviewer_home }}/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=KUBECONFIG={{ walle_reviewer_home }}/.kube/config
Environment=K3S_CONFIG_FILE=/dev/null
Environment=WALLE_ROOT={{ walle_root }}
Environment=WALLE_REVIEW_MODE={{ walle_review_mode }}
ExecStart={{ walle_root }}/app/bin/review-pending
TimeoutStartSec=2h
