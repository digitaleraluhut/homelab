# {{ ansible_managed }}
# The operator reviews WALL-E's pending requests in a headless Claude Code run
# (owner decision 2026-11-12). The job must move every request out of
# outbox/pending, or the path unit starts it again; the start limit stops a loop.
[Unit]
Description=Operator review of WALL-E's requests
StartLimitIntervalSec=1h
StartLimitBurst=4

[Service]
Type=oneshot
User={{ walle_reviewer }}
UMask=0027
WorkingDirectory={{ walle_reviewer_home }}/projects/digitaleraluhut
Environment=PATH={{ walle_reviewer_home }}/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=KUBECONFIG={{ walle_reviewer_home }}/.kube/config
Environment=WALLE_ROOT={{ walle_root }}
ExecStart={{ walle_root }}/app/bin/review-pending
TimeoutStartSec=2h
