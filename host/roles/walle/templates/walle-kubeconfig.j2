# {{ ansible_managed }}
# WALL-E's kubeconfig: no token. The bridge on localhost serves only user
# {{ walle_user }} and passes requests to kubectl proxy (walle-kube.service),
# which adds the token. Read-only by RBAC and by the proxy's filters.
apiVersion: v1
kind: Config
clusters:
  - name: homelab
    cluster:
      server: http://127.0.0.1:{{ walle_kube_bridge_port }}
users:
  - name: walle
    user: {}
contexts:
  - name: walle
    context:
      cluster: homelab
      user: walle
current-context: walle
