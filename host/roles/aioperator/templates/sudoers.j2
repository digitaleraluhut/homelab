# {{ ansible_managed }}
# Sudo whitelist for the AI operator. Change it only by PR to
# digitaleraluhut/homelab (host/roles/aioperator/defaults/main.yml).
# Note: a command without arguments allows ANY arguments in sudoers;
#       with "" no arguments are allowed.
{% for name, commands in aioperator_sudo_aliases.items() %}
Cmnd_Alias {{ name }} = \
  {{ commands | join(', \\\n  ') }}
{% endfor %}

{% for rule in aioperator_sudo_rules %}
{{ aioperator_user }} ALL={{ rule }}
{% endfor %}
