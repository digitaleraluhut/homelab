#!/usr/bin/python3
# {{ ansible_managed }}
"""Mint a short-lived GitHub App installation token for the AI operator.

Runs as root (sudo whitelist, no arguments). Reads the App private key, which
the operator cannot read, and prints {"token": ..., "expires_at": ...}.
The token is limited to the repositories and permissions below, even if the
App installation grants more.

Config (placed by the owner, not in git):
  {{ aioperator_github_app_dir }}/private-key.pem  root 0600
  {{ aioperator_github_app_dir }}/app.env          APP_ID=, INSTALLATION_ID=
"""
import base64
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request

CONFIG_DIR = os.environ.get("HOMELAB_GITHUB_APP_DIR", {{ aioperator_github_app_dir | to_json }})
API = os.environ.get("HOMELAB_GITHUB_API", "https://api.github.com")
REPOSITORIES = {{ aioperator_github_repositories | to_json }}
PERMISSIONS = {{ aioperator_github_permissions | to_json }}


def b64url(data: bytes) -> str:
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()


def read_env(path: str) -> dict:
    env = {}
    with open(path) as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                key, value = line.split("=", 1)
                env[key.strip()] = value.strip()
    return env


def app_jwt(app_id: str, key_path: str) -> str:
    now = int(time.time())
    header = b64url(json.dumps({"alg": "RS256", "typ": "JWT"}).encode())
    payload = b64url(json.dumps({"iat": now - 60, "exp": now + 540, "iss": app_id}).encode())
    signing_input = f"{header}.{payload}".encode()
    signature = subprocess.run(
        ["openssl", "dgst", "-sha256", "-sign", key_path],
        input=signing_input, capture_output=True, check=True,
    ).stdout
    return f"{header}.{payload}.{b64url(signature)}"


def main() -> int:
    if len(sys.argv) > 1:
        print("usage: homelab-operator-github-token (no arguments)", file=sys.stderr)
        return 2
    try:
        env = read_env(os.path.join(CONFIG_DIR, "app.env"))
        app_id, installation_id = env["APP_ID"], env["INSTALLATION_ID"]
        jwt = app_jwt(app_id, os.path.join(CONFIG_DIR, "private-key.pem"))
    except (OSError, KeyError, subprocess.CalledProcessError) as e:
        print(f"GitHub App not configured in {CONFIG_DIR}: {e}", file=sys.stderr)
        return 1

    body = json.dumps({"repositories": REPOSITORIES, "permissions": PERMISSIONS}).encode()
    request = urllib.request.Request(
        f"{API}/app/installations/{installation_id}/access_tokens",
        data=body,
        method="POST",
        headers={
            "Accept": "application/vnd.github+json",
            "Authorization": f"Bearer {jwt}",
            "X-GitHub-Api-Version": "2022-11-28",
            "User-Agent": "homelab-operator-github-token",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            data = json.load(response)
    except urllib.error.HTTPError as e:
        print(f"GitHub API {e.code}: {e.read().decode(errors='replace')}", file=sys.stderr)
        return 1
    print(json.dumps({"token": data["token"], "expires_at": data["expires_at"]}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
