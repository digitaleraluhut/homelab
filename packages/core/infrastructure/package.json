{
  "name": "@mrsimpson/homelab-core-infrastructure",
  "version": "0.1.0",
  "description": "Core infrastructure modules for homelab (Cloudflare, cert-manager, ingress, secrets)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "pretype-check": "npm run build -w @mrsimpson/homelab-core-components",
    "type-check": "tsc --noEmit",
    "pretest": "npm run build -w @mrsimpson/homelab-core-components",
    "test": "vitest run"
  },
  "keywords": [
    "pulumi",
    "kubernetes",
    "homelab",
    "infrastructure",
    "cloudflare-tunnel",
    "cert-manager",
    "ingress-nginx",
    "external-secrets"
  ],
  "author": "mrsimpson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrsimpson/homelab.git",
    "directory": "packages/core/infrastructure"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^26.0.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@mrsimpson/homelab-config": "*",
    "@mrsimpson/homelab-core-components": "*"
  },
  "peerDependencies": {
    "@pulumi/cloudflare": "^5.42.0",
    "@pulumi/kubernetes": "^4.18.3",
    "@pulumi/pulumi": "^3.137.0",
    "@pulumi/random": "^4.16.0"
  }
}
